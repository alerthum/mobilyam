{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/verify/:token",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge-cutlists",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/cutlists.js": {
      "maxDuration": 30
    }
  }
}
