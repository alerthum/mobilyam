# Uretim / Vercel: Vercel Postgres veya Neon baglanti URL'si
DATABASE_URL=

# QR ve üyelik doğrulama linkleri (localhost’ta da bu adres kullanılır)
VITE_PUBLIC_APP_URL=https://mobilyam.vercel.app

# Oturum imzasi (ozel bir string; paylasmayin)
SESSION_SECRET=

# Kesim listesi dosyalari (Vercel Blob). Yoksa yerel data/cutlists/ kullanilir.
BLOB_READ_WRITE_TOKEN=

# Gunluk kesim listesi temizligi (Vercel Cron). Uretimde zorunlu onerilir.
CRON_SECRET=

# Lokal gelistirme icin istege bagli (npm run migrate:state)
# .env.local dosyasina ayni anahtarlari kopyalayabilirsiniz; bu dosyayi commitlemeyin.
